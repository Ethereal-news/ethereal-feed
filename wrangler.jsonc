{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethereal-feed",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Uncomment once the river renders on the workers.dev URL.
  // Deploying with this line attaches feed.ethereal.news and creates its DNS record.
  // "routes": [{ "pattern": "feed.ethereal.news", "custom_domain": true }],

  "triggers": { "crons": ["*/30 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ethereal-feed",
      "database_id": "0ca07c90-27d3-4f88-bc31-2f81c8bf40cb",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "SITE_URL": "https://feed.ethereal.news",
    "SITE_NAME": "Ethereal news feed"
  },

  "observability": { "enabled": true }
}
