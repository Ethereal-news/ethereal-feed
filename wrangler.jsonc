{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ethereal-feed",
  "main": "src/index.ts",
  // Favicons and logo, served before the Worker runs for matching paths.
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "routes": [{ "pattern": "feed.ethereal.news", "custom_domain": true }],
  // Adding a route turns workers.dev off by default; keep it as a fallback URL.
  "workers_dev": true,

  "triggers": { "crons": ["7,37 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ethereal-feed",
      "database_id": "0ca07c90-27d3-4f88-bc31-2f81c8bf40cb",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "SITE_URL": "https://feed.ethereal.news",
    "SITE_NAME": "Ethereal news feed"
  },

  "observability": { "enabled": true }
}
