{
  "name": "ethereal-feed",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ethereal-feed --local",
    "db:migrate": "wrangler d1 migrations apply ethereal-feed --remote",
    "cron:local": "curl -s \"http://localhost:8787/__scheduled?cron=7,37+*+*+*+*\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
